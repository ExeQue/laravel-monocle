{
    "name": "exeque/laravel-monocle",
    "description": "Agent-focused request profiler for Laravel with an MCP server: timing spans, queries, cache, filesystem, AI agent calls and more.",
    "type": "library",
    "license": "MIT",
    "minimum-stability": "stable",
    "keywords": [
        "laravel",
        "profiler",
        "mcp",
        "debug",
        "timing",
        "agent"
    ],
    "authors": [
        {
            "name": "Morten Harders",
            "email": "mmh@harders-it.dk"
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/contracts": "^13.0",
        "illuminate/support": "^13.0",
        "laravel/agent-detector": "^2.0",
        "laravel/boost": "^2.10",
        "laravel/mcp": "^1.0"
    },
    "require-dev": {
        "brianium/paratest": "7.26.0",
        "franbarbalopez/mirror": "^2.0",
        "inertiajs/inertia-laravel": "^3.5",
        "lab404/laravel-impersonate": "^1.7",
        "laravel/ai": "^1.0",
        "laravel/folio": "^1.2",
        "laravel/fortify": "^1.41",
        "laravel/octane": "^2.21",
        "laravel/pennant": "^1.26",
        "laravel/pint": "^1.21",
        "laravel/sanctum": "^4.3",
        "livewire/livewire": "^4.0",
        "nuwave/lighthouse": "^6.72",
        "orchestra/testbench": "^11.3",
        "pestphp/pest": "^5.0",
        "prism-php/prism": "^0.100",
        "rebing/graphql-laravel": "^10.1",
        "spatie/laravel-event-sourcing": "^7.15",
        "spatie/laravel-medialibrary": "^11.23",
        "spatie/laravel-responsecache": "^8.4",
        "stechstudio/filament-impersonate": "^5.0",
        "symfony/var-dumper": "^8.0"
    },
    "suggest": {
        "laravel/ai": "Required to record agent, step and tool calls with the AiLens.",
        "livewire/livewire": "Required to record component lifecycle with the LivewireLens.",
        "prism-php/prism": "Required to record text, structured, stream, embeddings and other calls with the PrismLens."
    },
    "autoload": {
        "psr-4": {
            "ExeQue\\Monocle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "ExeQue\\Monocle\\MonocleServiceProvider"
            ],
            "aliases": {
                "Monocle": "ExeQue\\Monocle\\Facades\\Monocle"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "vendor/bin/pest -p",
        "lint": [
            "@lint:code",
            "@lint:blade"
        ],
        "lint:code": "vendor/bin/pint -p",
        "lint:blade": "vendor/bin/pint --blade resources/views tests/Fixtures/views workbench/resources/views",
        "lint:test": [
            "vendor/bin/pint -p --test",
            "vendor/bin/pint --blade --test resources/views tests/Fixtures/views workbench/resources/views"
        ],
        "pre-commit": [
            "@composer lint",
            "@composer test"
        ],
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "test:coverage": "vendor/bin/pest -p --coverage --min=100",
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "queue": [
            "Composer\\Config::disableProcessTimeout",
            "@php vendor/bin/testbench queue:work database --sleep=1 --ansi"
        ],
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi --host=0.0.0.0 --port=8000"
        ]
    }
}
